SENTINELMESH_MULTI_PORT_MINIMUM_PORTS=5
SENTINELMESH_BASELINE_WINDOW_SIZE=50
SENTINELMESH_BASELINE_MIN_HISTORY=5
SENTINELMESH_BASELINE_Z_SCORE_THRESHOLD=3.0
SENTINELMESH_BEACON_MIN_FLOWS=6
SENTINELMESH_BEACON_MIN_INTERVAL_SECONDS=30
